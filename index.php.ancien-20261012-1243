function toggleTheme() {
  var html = document.documentElement;
  var next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  html.setAttribute('data-theme', next);
  localStorage.setItem('vox-theme', next);
  var icon = document.getElementById('theme-icon');
  if (icon) {
    icon.innerHTML = next === 'light'
      ? '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>'
      : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>';
  }
}

function onVoiceUiChange() {
  var sel = g('cfg-tts-voice-ui');
  if (!sel) { return; }
  // Stocker uniquement la langue publique (fr|en)
  // La voix technique est résolue par proxy-tts.php depuis settings.json
  if (typeof config !== 'undefined') { config.ttsVoiceId = sel.value; }
  saveConfig();
}

function toggleInstructField() {
  var cb   = g('cfg-tts-instruct');
  var wrap = g('instruct-prompt-wrap');
  if (wrap) { wrap.style.display = (cb && cb.checked) ? 'block' : 'none'; }
  saveConfig();
}

function testTtsDirect() {
  ttsUnlock();
  resetTtsBuffer();
  var testText = '<?= $_isFr
    ? 'Bonjour, ceci est un test de la voix. Elle devrait fonctionner correctement.'
    : 'Hello, this is a voice test. It should work correctly.' ?>';
  testText.split(' ').forEach(function(word) { feedTtsToken(word + ' '); });
  flushTtsBuffer();
}

function filterOptions() {
       const searchValue = document.getElementById('cfg-llm-model').value.toLowerCase();
       const selectElement = document.getElementById('cfg-llmList-model');
       if (!selectElement) {
           console.log("Le select n'existe pas !");
           return;
       }
       const options = selectElement.options;
       for (let i = 0; i < options.length; i++) {
           const optionText = options[i].text.toLowerCase();
           options[i].style.display = optionText.includes(searchValue) ? '' : 'none';
       }
   }

document.addEventListener('DOMContentLoaded', function() {
   filterOptions();
  // Version
  var el = document.getElementById('vox-version');
  if (el && typeof VOXMIND_VERSION !== 'undefined') { el.textContent = VOXMIND_VERSION; }

  // Restaurer le select voix depuis config
  var voiceSel = g('cfg-tts-voice-ui');
  if (voiceSel && typeof config !== 'undefined' && config.ttsVoiceId) {
    voiceSel.value = config.ttsVoiceId;
  }

  // i18n
  if (typeof initI18n === 'function') { initI18n(); }

   document.getElementById('cfg-llm-model').addEventListener('input', function() {
    const searchValue = this.value.toLowerCase();
    const select = document.getElementById('cfg-llmList-model');
    let firstMatch = null;

    // Filtrage des options
    for (let opt of select.options) {
        const isVisible = opt.text.includes(searchValue);
        opt.style.display = isVisible ? '' : 'none';
        if (isVisible && !firstMatch) {
            firstMatch = opt;
        }
    }

    // Sélection de la première option visible
    if (firstMatch) {
        select.value = firstMatch.value;
        console.log("Première option visible sélectionnée :", firstMatch.text);
    } else {
        console.log("Aucune option ne correspond à la recherche.");
    }
});

});
</script>
