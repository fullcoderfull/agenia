<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="8" />
      <error statusCode="404" subStatusCode="8" path="/errors/404.html" responseMode="File" />
      
      <!-- Couvrir aussi les autres erreurs courantes -->
      <remove statusCode="403" />
      <error statusCode="403" path="/errors/403.html" responseMode="File" />
      
      <remove statusCode="500" />
      <error statusCode="500" path="/errors/500.html" responseMode="File" />
    </httpErrors>
    <handlers>
            <add name="txt" path="*.txt" verb="GET" modules="StaticFileModule,DefaultDocumentModule,DirectoryListingModule" resourceType="File" requireAccess="Read" />
      <add name="php8.3" path="*.php" verb="*" modules="FastCgiModule" scriptProcessor="E:\php\php8.3\php-cgi.exe" resourceType="File" requireAccess="Script" />
    </handlers>

    <defaultDocument>
      <files>
        <add value="index.php" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="true" />

    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

    <httpCompression>
      <scheme name="gzip" dll="%Windir%\system32\inetsrv\gzip.dll" staticCompressionLevel="0" dynamicCompressionLevel="0" />
    </httpCompression>

    <rewrite>
      <rules>
        <rule name="login">
          <match url="^login$" />
          <action type="Rewrite" url="/login.php" />
        </rule>
        <rule name="rgpd">
          <match url="^rgpd$" />
          <action type="Rewrite" url="/rgpd.php" />
        </rule>
        <rule name="partner">
          <match url="^partner$" />
          <action type="Rewrite" url="/partner-auth.php" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="config" />
          <add segment="lib" />
          <add segment="logs" />
          <add segment=".git" />

          <add segment="data" />
                    <add segment="business" />
        </hiddenSegments>
      </requestFiltering>
    </security>

  </system.webServer>

  <!-- Streaming LLM — désactiver cache et compression sur proxy-llm.php -->
  <location path="proxy-llm.php">
    <system.webServer>
      <urlCompression doStaticCompression="false" doDynamicCompression="false" />
      <httpProtocol>
        <customHeaders>
          <add name="X-Accel-Buffering" value="no" />
          <add name="Cache-Control" value="no-cache, no-store" />
          <add name="Content-Encoding" value="none" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

</configuration>