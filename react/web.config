<?xml version="1.0" encoding="UTF-8"?>
<!-- Dossier source Next.js : aucun fichier ne doit être servi par IIS. -->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="false">
          <clear />
        </fileExtensions>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="src" />
          <add segment="out" />
          <add segment=".next" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
