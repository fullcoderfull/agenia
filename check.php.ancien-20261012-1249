<?php
// =============================================================================
// check.php — Authentification unifiée : admin/demo (cookie HMAC) + partenaire (JWT)
// Expose : $authUser, $authRole, $isAdmin, $isDemo, $isPartner, $partnerData
// =============================================================================

error_reporting(E_ALL);
ini_set('log_errors', '1');
ini_set('error_log', __DIR__ . '/logs/boot_' . date('Y-m-d') . '.log');



require_once __DIR__ . '/config/secrets.php';
require_once __DIR__ . '/lib/debug.php';
require_once __DIR__ . '/lib/license.php';
license_enforce();
require_once __DIR__ . '/lib/security.php';
require_once __DIR__ . '/lib/jwt.php';
require_once __DIR__ . '/lib/db.php';
require_once __DIR__ . '/lib/db_helpers.php';
require_once __DIR__ . '/lib/auth_guest.php';

$_vox_users    = require __DIR__ . '/config/users.php';
$_vox_partners = require __DIR__ . '/config/partners.php';

debug_log('CHECK', 'START', ['uri' => $_SERVER['REQUEST_URI'] ?? '']);

// ── Helpers HMAC ──────────────────────────────────────────────────────────────
function vox_make_token(string $user, int $exp): string {
  $sig = hash_hmac('sha256', $user . '|' . $exp, HMAC_SECRET);
  return base64_encode($user . '|' . $exp . '|' . $sig);
}

function vox_check_token(string $token): string|false {
  $decoded = base64_decode($token, true);
  if (!$decoded) { return false; }
  $parts = explode('|', $decoded);
  if (count($parts) !== 3) { return false; }
  [$user, $exp, $sig] = $parts;
  if (time() > (int)$exp) { return false; }
  $expected = hash_hmac('sha256', $user . '|' . $exp, HMAC_SECRET);
  return hash_equals($expected, $sig) ? $user : false;
}

function vox_set_cookie(string $user): void {
  $exp   = time() + SESSION_TTL;
  $token = vox_make_token($user, $exp);
  setcookie('vox', $token, [
    'expires' => $exp, 'path' => '/',
    'secure' => true, 'httponly' => true, 'samesite' => 'Strict',
  ]);
}

// ── Initialisation ────────────────────────────────────────────────────────────
$authUser    = false;
$authRole    = '';
$isPartner   = false;
$partnerData = null;
$ip          = get_client_ip();
$isSuperAdmin = (defined('SUPERADMIN_USER') && $authUser === SUPERADMIN_USER);
$GLOBALS['isSuperAdmin'] = $isSuperAdmin;
if (!rl_check('global_' . $ip, 30, 60)) {
  http_response_code(429);
  header('Content-Type: application/json');
  echo json_encode(['error' => 'Trop de requêtes ont été exécutées']);
  exit;
}

// ── 1. Bearer API token ───────────────────────────────────────────────────────
$bearer = '';
$ah     = $_SERVER['HTTP_AUTHORIZATION'] ?? ($_SERVER['REDIRECT_HTTP_AUTHORIZATION'] ?? '');
if (str_starts_with($ah, 'Bearer ')) { $bearer = substr($ah, 7); }

if ($bearer) {
  foreach ($_vox_users as $uname => $udata) {
    if (isset($udata['api_token']) && $udata['api_token'] && hash_equals($udata['api_token'], $bearer)) {
      $authUser = $uname;
      $authRole = $udata['role'];
      vox_set_cookie($uname);
      debug_log('CHECK', 'AUTH_BEARER', ['user' => $uname]);
      break;
    }
  }
}

// ── 2. Cookie HMAC ────────────────────────────────────────────────────────────
if (!$authUser && isset($_COOKIE['vox'])) {
  $u = vox_check_token($_COOKIE['vox']);
  if ($u && isset($_vox_users[$u])) {
    $authUser = $u;
    $authRole = $_vox_users[$u]['role'];
    vox_set_cookie($u);
    debug_log('CHECK', 'AUTH_COOKIE', ['user' => $u]);
  }
}

// ── 3. Cookie JWT partenaire ──────────────────────────────────────────────────
if (!$authUser && isset($_COOKIE['vox_partner']) && isset($_COOKIE['vox_partner_id'])) {
  $pid = sanitize_string($_COOKIE['vox_partner_id'], 64);
  if (isset($_vox_partners[$pid]) && $_vox_partners[$pid]['active']) {
    $p       = $_vox_partners[$pid];
    $payload = jwt_decode($_COOKIE['vox_partner'], $p['secret']);
    if ($payload && $p['expires'] >= date('Y-m-d')) {
      $partnerBearer = $p['api_bearer'] ?? null;
      $bearerValid   = $partnerBearer && $bearer && hash_equals($partnerBearer, $bearer);
      $bearerBoost   = $bearerValid ? ($p['quota_boost'] ?? 1) : 1;
      $quotaLlm      = $p['quota_day'] * $bearerBoost;
      if (quota_get($pid, 'llm') >= $quotaLlm) {
        http_response_code(429);
        header('Content-Type: application/json');
        echo json_encode(['error' => 'Quota journalier atteint', 'quota' => $quotaLlm]);
        exit;
      }
      $authUser    = $pid;
      $authRole    = 'partner';
      $isPartner   = true;
      $partnerData = ['id' => $pid, 'vision' => $p['vision'], 'quota' => $quotaLlm, 'name' => $p['name']];
      debug_log('CHECK', 'AUTH_PARTNER', ['pid' => $pid]);
    }
  }
}

// ── 3b. Cookie guest ──────────────────────────────────────────────────────────
if (!$authUser && isset($_COOKIE['vox_guest'])) {
  $guestData = guest_validate($_COOKIE['vox_guest']);
  if ($guestData !== false) {
    $authUser  = 'guest_' . $guestData['id'];
    $authRole  = 'guest';
    $remaining = $guestData['expires_at'] - time();
    if ($remaining > 300) {
      setcookie('vox_guest', $_COOKIE['vox_guest'], [
        'expires'  => $guestData['expires_at'],
        'path'     => '/',
        'secure'   => true,
        'httponly' => true,
        'samesite' => 'Strict',
      ]);
    }
    $GLOBALS['guestData']    = $guestData;
    $GLOBALS['guestExpires'] = $guestData['expires_at'];
    debug_log('CHECK', 'AUTH_GUEST', ['id' => $guestData['id'], 'remaining' => $remaining]);
  }
}

// ── 4. Redirect si non authentifié ───────────────────────────────────────────
if (!$authUser) {
  debug_log('CHECK', 'AUTH_FAIL', ['uri' => $_SERVER['REQUEST_URI'] ?? '']);
  $isApi = isset($_SERVER['REQUEST_URI']) && (
    str_contains($_SERVER['REQUEST_URI'], 'proxy-') ||
    str_contains($_SERVER['REQUEST_URI'], 'partner-auth')
  );
  if ($isApi) {
    http_response_code(401);
    header('Content-Type: application/json');
    echo json_encode(['error' => 'Non authentifié']);
    exit;
  }
  $host = $_SERVER['HTTP_HOST'] ?? '172.17.164.70';
  header('Location: https://' . $host . '/login.php');
  exit;
}

$isAdmin = ($authRole === 'admin');
$isDemo  = ($authRole === 'demo');
$isGuest = ($authRole === 'guest');

debug_log('CHECK', 'AUTH_OK', ['user' => $authUser, 'role' => $authRole]);

// ── Headers sécurité HTTP ─────────────────────────────────────────────────────
if (!headers_sent()) {
  header("X-Frame-Options: DENY");
  header("X-Content-Type-Options: nosniff");
  header("Referrer-Policy: strict-origin-when-cross-origin");
  header("Permissions-Policy: camera=(self), microphone=(self), geolocation=()");
  header("Content-Security-Policy: default-src 'self'; "
       . "script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; "
       . "worker-src blob: 'self'; "
       . "style-src 'self' 'unsafe-inline'; "
       . "connect-src 'self'; "
       . "media-src 'self' blob:; "
       . "img-src 'self' data: blob:; "
       . "frame-ancestors 'none';");
}

// ── Export globaux ────────────────────────────────────────────────────────────
$GLOBALS['authUser']    = $authUser;
$GLOBALS['authRole']    = $authRole;
$GLOBALS['isAdmin']     = $isAdmin;
$GLOBALS['isDemo']      = $isDemo;
$GLOBALS['isPartner']   = $isPartner;
$GLOBALS['partnerData'] = $partnerData;
$GLOBALS['isGuest']     = $isGuest;
$GLOBALS['guestData']   = $GLOBALS['guestData'] ?? null;

$isSuperAdmin = (defined('SUPERADMIN_USER') && $authUser === SUPERADMIN_USER);
$GLOBALS['isSuperAdmin'] = $isSuperAdmin;