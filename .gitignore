# =============================================================================
# Agenia — fichiers exclus du dépôt
# Un secret poussé une fois reste dans l'historique Git, même supprimé ensuite.
# Vérifier une règle : git check-ignore -v <fichier>
# =============================================================================

# --- Secrets et comptes (seuls les modèles *.example.php sont versionnés) ---
config/secrets*.php
!config/secrets.example.php
config/users.php
config/partners.php
.env
.env.*
appsettings*.json
*.pfx
*.pem
*.key

# --- API de paiement .NET (dépôt séparé et privé) ---
business/

# --- Données, journaux, audit ---
data/
logs/
*.log
*.jsonl

# --- Offre PRO et administration (non publiées) ---
superadmin/
superadmin-front.php
superadmin-journal.php
api/superadmin/
api/superadmin-back.php
js/superadmin.js
css/superadmin.css

# --- Pages de test et de débogage ---
proxy-stripe-debug.php
whoami.php
test.php
debug-test.php
mock-openrouter.php
setup-generate.php

# --- Sauvegardes et fichiers de travail ---
*.avant-*
*.bak
*.bak_*
*.bak-*
*-old.json
*-bck.js
inventaire-*.csv
_quarantaine/
agenia-*.zip
agenia-*/

# --- Documentation interne et médias lourds ---
docs/
github.md
*.mp4

# --- Front : dépendances et builds (app/ est régénéré par npm run deploy) ---
react/node_modules/
react/out/
react/.next/
react/next-env.d.ts
app/

# --- Système et éditeurs ---
Thumbs.db
Desktop.ini
.DS_Store
.vs/
.vscode/
.idea/
.continue/

# --- Configuration locale (prompt systeme, adresses internes) ---
config/settings.json
