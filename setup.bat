@echo off
:: =============================================================================
:: VoxMind ? Setup IIS (Windows)
:: G?n?re la master key, la signature et configure les droits NTFS
:: ? ex?cuter en Administrateur
:: =============================================================================
setlocal EnableDelayedExpansion

echo.
echo   +=======================================+
echo   |      VoxMind ? Setup IIS Windows      |
echo   +=======================================+
echo.

:: ?? Param?tres ??????????????????????????????????????????????????????????????
set /p DOMAIN="  Domaine (ex: voxmind.mondomaine.com) : "
set /p POOL="  Nom du pool IIS (ex: lepool) : "
set /p ROOT="  Chemin racine (ex: E:\projets\AgenIa\voxmind3) : "

if "%DOMAIN%"=="" (echo   [ERREUR] Domaine requis & exit /b 1)
if "%POOL%"=="" (echo   [ERREUR] Pool IIS requis & exit /b 1)
if "%ROOT%"=="" (echo   [ERREUR] Chemin requis & exit /b 1)

echo.
echo   ?? 1. G?n?ration des cl?s ??????????????????????????????????????????????
echo.

:: G?n?rer master key via PHP
for /f "delims=" %%k in ('php -r "echo bin2hex(random_bytes(32));"') do set MASTER_KEY=%%k
echo   [OK] Master key g?n?r?e

:: G?n?rer signature
for /f "delims=" %%s in ('php -r "echo hash_hmac('sha256', '%DOMAIN%', '%MASTER_KEY%');"') do set SIGNATURE=%%s
echo   [OK] Signature : %SIGNATURE:~0,16%...

:: G?n?rer HMAC secret sessions
for /f "delims=" %%h in ('php -r "echo bin2hex(random_bytes(32));"') do set HMAC_SECRET=%%h
echo   [OK] HMAC secret g?n?r?

echo.
echo   ?? 2. Cr?ation secrets.php ?????????????????????????????????????????????
echo.

if exist "%ROOT%\config\secrets.php" (
  copy /Y "%ROOT%\config\secrets.php" "%ROOT%\config\secrets.php.bak" >nul
  echo   [BACKUP] Backup : secrets.php.bak
)

(
echo ^<?php
echo // =============================================================================
echo // config/secrets.php ? G?N?R? par setup-iis.bat ? NE JAMAIS COMMITTER
echo // =============================================================================
echo.
echo // ?? Verrouillage d'instance ??????????????????????????????????????????????????
echo define('LICENSE_DOMAIN',     '%DOMAIN%'^);
echo define('LICENSE_SIGNATURE',  '%SIGNATURE%'^);
echo define('LICENSE_MASTER_KEY', '%MASTER_KEY%'^);
echo.
echo // ?? Sessions ????????????????????????????????????????????????????????????????
echo define('HMAC_SECRET',  '%HMAC_SECRET%'^);
echo define('SESSION_TTL',  3600^);
echo.
echo // ?? LLM (Ollama local^) ????????????????????????????????????????????????????
echo define('LLM_URL',    'http://172.17.164.70:11434'^);
echo define('LLM_MODEL',  'llama3.1'^);
echo define('LLM_KEY',    ''^);
echo define('LLM_BEARER',    ''^);
echo define('TTS_BEARER',    '');
echo define('STT_BEARER',    '');

echo.
echo // ?? TTS ?????????????????????????????????????????????????????????????????????
echo define('TTS_URL',    'http://172.17.164.70:8880'^);
echo define('TTS_MODEL',  'kokoro'^);
echo define('TTS_VOICE',  'af_sky'^);
echo.
echo // ?? STT ?????????????????????????????????????????????????????????????????????
echo define('STT_URL',    'http://172.17.164.70:8990'^);
echo define('STT_MODEL',  'large-v3'^);
echo.
echo // ?? Authentification ????????????????????????????????????????????????????????
echo define('AUTH_BACKEND', 'file'^);
echo.
echo // ?? MySQL (si AUTH_BACKEND === 'mysql'^) ????????????????????????????????????
echo define('DB_HOST', '172.17.164.70'^);
echo define('DB_NAME', 'voxmind'^);
echo define('DB_USER', 'voxmind_app'^);
echo define('DB_PASS', 'CHANGEME'^);
echo.
echo // ?? UI ??????????????????????????????????????????????????????????????????????
echo define('UI_LANG', 'fr'^);
echo.
echo // ?? Debug ???????????????????????????????????????????????????????????????????
echo define('DEBUG_LOG', false^);
) > "%ROOT%\config\secrets.php"

echo   [OK] secrets.php g?n?r?

echo.
echo   ?? 3. Cr?ation des dossiers ????????????????????????????????????????????
echo.

if not exist "%ROOT%\logs" mkdir "%ROOT%\logs"
if not exist "%ROOT%\config\rate-limits" mkdir "%ROOT%\config\rate-limits"
if not exist "%ROOT%\modules" mkdir "%ROOT%\modules"
echo   [OK] Dossiers cr??s (logs, rate-limits, modules)

echo.
echo   ?? 4. Droits NTFS (IIS AppPool\%POOL%) ????????????????????????????????
echo.

:: Racine ? lecture + ex?cution PHP
icacls "%ROOT%" /grant "IIS AppPool\%POOL%:(OI)(CI)RX" /T /Q
echo   [OK] Racine : RX

:: config/ ? lecture PHP, pas d'?criture
icacls "%ROOT%\config" /grant "IIS AppPool\%POOL%:(OI)(CI)R" /T /Q
icacls "%ROOT%\config" /deny  "IIS AppPool\%POOL%:(OI)(CI)(W,D)" /Q
echo   [OK] config/ : R (deny W,D)

:: config/rate-limits/ ? lecture + ?criture (compteurs JSON)
icacls "%ROOT%\config\rate-limits" /grant "IIS AppPool\%POOL%:(OI)(CI)RW" /T /Q
echo   [OK] config/rate-limits/ : RW

:: lib/ ? lecture seule
icacls "%ROOT%\lib" /grant "IIS AppPool\%POOL%:(OI)(CI)R" /T /Q
icacls "%ROOT%\lib" /deny  "IIS AppPool\%POOL%:(OI)(CI)(W,D)" /Q
echo   [OK] lib/ : R (deny W,D)

:: modules/ ? lecture seule
icacls "%ROOT%\modules" /grant "IIS AppPool\%POOL%:(OI)(CI)R" /T /Q
icacls "%ROOT%\modules" /deny  "IIS AppPool\%POOL%:(OI)(CI)(W,D)" /Q
echo   [OK] modules/ : R (deny W,D)

:: js/ ? lecture seule
icacls "%ROOT%\js" /grant "IIS AppPool\%POOL%:(OI)(CI)R" /T /Q
icacls "%ROOT%\js" /deny  "IIS AppPool\%POOL%:(OI)(CI)(W,D)" /Q
echo   [OK] js/ : R (deny W,D)

:: logs/ ? lecture + ?criture (PHP ?crit les logs)
icacls "%ROOT%\logs" /grant "IIS AppPool\%POOL%:(OI)(CI)RW" /T /Q
echo   [OK] logs/ : RW

:: sql/ ? aucun acc?s IIS
icacls "%ROOT%\sql" /deny "IIS AppPool\%POOL%:(OI)(CI)(R,W,X)" /Q
echo   [OK] sql/ : aucun acc?s IIS

echo.
echo   ?? 5. FastCGI ? flushNamedPipe ?????????????????????????????????????????
echo.

:: V?rifier si PHP est dans FastCGI
php -r "echo 'PHP OK';" >nul 2>&1
if %errorlevel% neq 0 (
  echo   [ATTENTION] PHP non trouv? dans le PATH ? configurez FastCGI manuellement
) else (
  for /f "delims=" %%p in ('php -r "echo PHP_BINARY;"') do set PHP_PATH=%%p
  echo   PHP : !PHP_PATH!
  echo   [INFO] Ajoutez flushNamedPipe="true" dans applicationHost.config :
  echo     ^<application fullPath="!PHP_PATH!" flushNamedPipe="true" /^>
)

echo.
echo   +=======================================+
echo   |          Setup termin? [OK]              |
echo   +=======================================+
echo   |  Domaine    : %DOMAIN%
echo   |  Pool IIS   : %POOL%
echo   |  Racine     : %ROOT%
echo   +=======================================+
echo   |  Prochaines ?tapes :                  |
echo   |  1. ?ditez config/users.php           |
echo   |  2. Configurez LLM/TTS/STT URLs      |
echo   |  3. iisreset                          |
echo   +=======================================+
echo.

endlocal
pause